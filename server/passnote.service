# systemd unit for the passnote server (README.md). Edit User and the paths first: they assume a user "passnote" whose
# files (server.py, tokens.json, cert.pem, key.pem) live in /home/passnote/passnote. Install:
#   sudo cp passnote.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now passnote
[Unit]
Description=passnote mailbox for Claude Code agents
After=network-online.target
Wants=network-online.target

[Service]
User=passnote
WorkingDirectory=/home/passnote/passnote
ExecStart=/usr/bin/python3 /home/passnote/passnote/server.py serve --db /home/passnote/passnote/passnote.db --tokens /home/passnote/passnote/tokens.json --bind 0.0.0.0:8765 --cert /home/passnote/passnote/cert.pem --key /home/passnote/passnote/key.pem
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/passnote/passnote

[Install]
WantedBy=multi-user.target
